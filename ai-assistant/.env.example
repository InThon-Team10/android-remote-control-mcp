# DeepSeek (Lablup) — 이 파일은 .gitignore 처리됨. 절대 커밋하지 마세요.
LLM_BASE_URL=https://api.console.lablup.ai/v1
LLM_API_KEY=
LLM_MODEL=DeepSeek-V4.1-Flash-B300
# 위 이름으로 모델 오류가 나면 Lablup 가이드에 나온 이름으로 교체: deepseek-ai/DeepSeek-V4.1-Flash

# 폰 MCP 서버 (앱의 Server 탭에 표시되는 값)
#  - USB + adb forward 사용 시: http://127.0.0.1:8080/mcp
#  - 같은 Wi-Fi + 앱에서 바인딩 0.0.0.0 설정 시: http://<폰 IP>:8080/mcp
MCP_URL=http://127.0.0.1:8080/mcp
MCP_TOKEN=

# ---- Gemini (python ... --provider gemini 로 실행할 때 사용) ----
GEMINI_API_KEY=
# 모델 이름은 llm_check.py --provider gemini 실행 시 [1] 모델 목록에서 확인 가능
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_REASONING_EFFORT=low   # 생각(thinking) 줄여서 속도↑ (모델에 따라 지원 값 다름)
