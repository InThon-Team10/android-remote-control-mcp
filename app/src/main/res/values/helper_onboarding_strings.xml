<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="helper_onboard_skip">나중에 하기</string>
    <string name="helper_onboard_welcome_title">어서 오세요!\n저는 콕콕이예요.</string>
    <string name="helper_onboard_welcome_body">휴대폰을 쓰다가 막히면 불러 주세요. 다음에 누를 곳을 함께 찾아드릴게요.</string>
    <string name="helper_onboard_welcome_invite">사용법을 함께 배워볼까요?</string>
    <string name="helper_onboard_welcome_safety">연습용 화면에서 편하게 연습해요. 잘못 눌러도 괜찮아요.</string>
    <string name="helper_onboard_start_practice">함께 연습하기</string>
    <string name="helper_onboard_invite_title">이제 콕콕이를\n불러볼까요?</string>
    <string name="helper_onboard_invite_body">콕콕이를 켜 둘까요? 여기콕에서 ‘물어보기’를 누르면 콕콕이와 대화가 시작되고, 대화하는 동안 화면 옆에 도움 버튼이 생겨요.</string>
    <string name="helper_onboard_enable_yes">예, 콕콕이 켜기</string>
    <string name="helper_onboard_replay">한 번 더 연습하기</string>
    <string name="helper_onboard_permission_title">콕콕이가 화면을 보고 가리키려면\n허용이 필요해요</string>
    <string name="helper_onboard_permission_steps">다음 Android 설정에서 ‘설치된 앱’(기기에 따라 ‘다운로드한 앱’)의 ‘여기콕’을 찾아 켜 주세요. 확인창이 나오면 내용을 읽고 ‘허용’을 눌러 주세요.</string>
    <string name="helper_onboard_permission_choice">기기에 따라 ‘사용’ 또는 ‘확인’으로 표시될 수 있어요. 원하지 않으면 뒤로 돌아와도 괜찮아요.</string>
    <string name="helper_onboard_permission_ready">허용이 확인됐어요.</string>
    <string name="helper_onboard_permission_error">설정을 열지 못했어요. 휴대폰 설정의 접근성 메뉴에서 ‘여기콕’을 찾아 켜 주세요.</string>
    <string name="helper_onboard_open_settings">알겠어요, 설정 열기</string>
    <string name="helper_onboard_defer">지금은 하지 않을게요</string>
    <string name="helper_onboard_ask">물어보기</string>
    <string name="helper_onboard_enable_home">콕콕이 켜기</string>
    <string name="helper_onboard_practice_again">사용법 다시 연습하기</string>
    <string name="helper_consent_title">안내를 받기 전에\n확인해 주세요</string>
    <string name="helper_consent_body">콕콕이와 대화하는 동안 내 목소리와 입력한 글, 지금 화면의 글자·버튼 이름·위치가 OpenAI로 전송돼요. 필요하면 화면 사진(스크린샷)도 함께 전송돼요. 화면에 개인정보가 있으면 함께 전송될 수 있어요.</string>
    <string name="helper_consent_control">콕콕이는 누를 곳을 알려주고, 선택은 내가 직접 해요. 동의하지 않아도 사용법 연습은 할 수 있어요.</string>
    <string name="helper_consent_accept">화면 정보 전송에 동의하고 계속</string>
    <string name="helper_consent_defer">동의하지 않고 나중에 하기</string>
    <string name="helper_consent_error">동의를 저장하지 못했어요. 다시 시도해 주세요.</string>
    <string name="helper_mic_setup_title">말로 대화해 볼까요?</string>
    <string name="helper_mic_setup_body">마이크는 콕콕이와 말로 대화하는 동안에만 들어요. 대화가 끝나면 마이크도 꺼져요. 허용하지 않으면 지금은 대화를 시작할 수 없어요.</string>
    <string name="helper_mic_setup_privacy">대화하는 동안 말한 목소리는 OpenAI로 전송돼요.</string>
    <string name="helper_mic_setup_allow">마이크 허용하기</string>
    <string name="helper_mic_setup_skip">나중에 하기</string>
</resources>
