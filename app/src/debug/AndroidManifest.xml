<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application>
        <!-- E2E Configuration Receiver (test configuration injection via adb shell). -->
        <!-- Debug source set only, so it is absent from the release APK entirely. -->
        <!-- Also gated on DUMP: a signature/privileged platform permission held by the adb shell
             UID (com.android.shell) but NOT grantable to third-party apps, enforced by
             ActivityManager against the sender's real binder UID. Debug builds are published as
             release assets, so the source-set boundary alone does not keep this off user devices. -->
        <receiver
            android:name=".debug.E2EConfigReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Debug-only: lets E2E tests approve a pending OAuth authorization. Absent from release. -->
        <!-- Gated on DUMP (adb-shell-only) for the same reason as E2EConfigReceiver above:
             approving an authorization is an auth bypass, and debug APKs reach real devices. -->
        <receiver
            android:name=".debug.OAuthApprovalTestReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <activity
            android:name=".debug.assistant.AssistantTestActivity"
            android:exported="true"
            android:label="@string/assistant_debug_label"
            android:theme="@style/Theme.AndroidRemoteControlMcp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.helper.HelperPreviewActivity"
            android:exported="true"
            android:label="@string/helper_preview_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".ui.helper.HelperConnectionSettingsActivity" android:exported="false" />
        <activity android:name=".ui.helper.ConsequencePreviewActivity" android:exported="false" />
        <service
            android:name=".ui.helper.HelperOverlayPreviewService"
            android:exported="true"
            android:label="@string/helper_overlay_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/helper_overlay_accessibility" />
        </service>
    </application>

</manifest>
